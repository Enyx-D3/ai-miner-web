{
  "manifest_version": 3,
  "name": "brain2:inContext Capture",
  "version": "0.8.6",
  "minimum_chrome_version": "116",
  "description": "Captures completed ChatGPT, Claude, and Gemini turns into the brain2:inContext continuity workspace.",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "alarms",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "brain2:inContext"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": [
        "provider_adapters.js",
        "capture.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
