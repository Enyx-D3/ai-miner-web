# brain2:inContext environment template. Do not put real secrets in source.

# APP
# Public canonical app URL. Required for production SEO, callbacks, and provider review.
NEXT_PUBLIC_APP_URL=
# Set to production only for real production deploys; production validation fails closed.
BRAIN2_DEPLOY_ENV=development
# Local-only escape hatch for unfinished auth flows. Must never be 1 in production.
LOCAL_DEMO_MODE=0

# AUTH
# Mission 01 uses Supabase Auth with Google OAuth and server-only HttpOnly sessions.
AUTH_PROVIDER=supabase
AUTH_SESSION_SECRET=

# Google OAuth credentials configured in Supabase Auth provider settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase Auth/control-plane. Never expose the service role key to browser code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# BILLING
# Stripe is the planned paid-launch provider. Demo billing must never be enabled in production.
BILLING_DEMO_MODE=0
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_FOUNDER_LIFETIME=

# MCP / PROVIDER GATEWAY
INCONTEXT_MCP_BASE_URL=
INCONTEXT_MCP_SIGNING_SECRET=

# Brain2 P2P / Global Delta
# Leave blank when all devices use the same deployed brain2:inContext origin.
# Set this to a shared deployed signaling origin when separate local instances need to find each other.
NEXT_PUBLIC_BRAIN2_SIGNALING_URL=
# Server-authoritative RTCConfiguration iceServers array returned to every registered Web/Android replica.
# Add production STUN/TURN credentials here for cross-NAT reliability.
# Example: [{"urls":["stun:stun.example.com:3478"]},{"urls":["turn:turn.example.com:3478"],"username":"...","credential":"..."}]
BRAIN2_ICE_SERVERS_JSON=
# Legacy/build-time Web fallback for already-paired clients that have not re-registered yet.
NEXT_PUBLIC_BRAIN2_ICE_SERVERS_JSON=
# Local Node signaling-mailbox database directory (server side).
BRAIN2_SYNC_DATA_DIR=.brain2-sync

# Local MCP Browser Bridge (server-only; never expose the token through NEXT_PUBLIC_*).
# The local setup script copies BRAIN2_BRIDGE_TOKEN from ai_miner_mcp/.env into Web .env.local.
BRAIN2_MCP_BRIDGE_URL=http://127.0.0.1:8787
# BRAIN2_BRIDGE_TOKEN=use-the-same-local-token-as-ai_miner_mcp
# Set to 1 only when deliberately proxying to a non-loopback MCP host.
BRAIN2_MCP_ALLOW_REMOTE=0

# ANALYTICS / ERROR MONITORING
# Optional. Missing keys disable vendor telemetry; raw AI history must never be sent as payload.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# EMAIL
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
