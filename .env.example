# Optional external control-plane/auth API. The local Brain2 memory workspace does not require it.
# NEXT_PUBLIC_BASE_URL=https://your-api.example.com/api/v1/

# Optional Google Identity client ID for the legacy auth surface.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Brain2 P2P / Global Delta
# Leave blank when all devices use the same deployed AI Miner origin.
# Set this to a shared deployed signaling origin when separate local instances need to find each other.
NEXT_PUBLIC_BRAIN2_SIGNALING_URL=
# JSON RTCConfiguration iceServers array. Add your production STUN/TURN credentials for cross-NAT reliability.
# Example: [{"urls":["stun:stun.example.com:3478"]},{"urls":["turn:turn.example.com:3478"],"username":"...","credential":"..."}]
NEXT_PUBLIC_BRAIN2_ICE_SERVERS_JSON=
# Local Node signaling-mailbox database directory (server side).
BRAIN2_SYNC_DATA_DIR=.brain2-sync

# Local MCP Browser Bridge (server-only; never expose the token through NEXT_PUBLIC_*).
# The local setup script copies BRAIN2_BRIDGE_TOKEN from ai_miner_mcp/.env into Web .env.local.
BRAIN2_MCP_BRIDGE_URL=http://127.0.0.1:8787
# BRAIN2_BRIDGE_TOKEN=use-the-same-local-token-as-ai_miner_mcp
# Set to 1 only when deliberately proxying to a non-loopback MCP host.
BRAIN2_MCP_ALLOW_REMOTE=0
